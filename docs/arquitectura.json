{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Carvajal Corpus · del scraping a la respuesta",
    "output": "docs/arquitectura.html",
    "viewBox": [1080, 560],
    "locale": "es",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "stages": [
    { "label": "Fuentes" },
    { "label": "Captura y limpieza" },
    { "label": "Gold" },
    { "label": "Índice RAG" },
    { "label": "Respuesta" }
  ],
  "nodes": [
    {
      "id": "oficial",
      "type": "cloud",
      "label": "SEEDS",
      "sublabel": "15 URLs oficiales",
      "stage": 0,
      "row": 0,
      "tag": "carvajal.com"
    },
    {
      "id": "terceros",
      "type": "cloud",
      "label": "EXTERNAL_SEEDS",
      "sublabel": "6 URLs prensa",
      "stage": 0,
      "row": 2,
      "tag": "tercero"
    },
    {
      "id": "webclient",
      "type": "backend",
      "label": "WebClient",
      "sublabel": "requests · 30 s",
      "stage": 1,
      "row": 0,
      "tag": "HTTP"
    },
    {
      "id": "extractor",
      "type": "backend",
      "label": "Extractor",
      "sublabel": "bs4 + lxml",
      "stage": 1,
      "row": 1,
      "tag": "sin chrome"
    },
    {
      "id": "gold",
      "type": "database",
      "label": "data/gold",
      "sublabel": "21 .md + metadata",
      "stage": 2,
      "row": 1,
      "tag": "versionado"
    },
    {
      "id": "chunker",
      "type": "backend",
      "label": "Chunking",
      "sublabel": "1000/200",
      "stage": 3,
      "row": 0,
      "tag": "LangChain"
    },
    {
      "id": "embeddings",
      "type": "backend",
      "label": "Embeddings",
      "sublabel": "nomic-embed-text",
      "stage": 3,
      "row": 1,
      "tag": "Ollama"
    },
    {
      "id": "faiss",
      "type": "database",
      "label": "data/index",
      "sublabel": "FAISS + SHA-256",
      "stage": 3,
      "row": 2,
      "tag": "caché"
    },
    {
      "id": "llm",
      "type": "cloud",
      "label": "LLM",
      "sublabel": "DeepSeek / Ollama",
      "stage": 4,
      "row": 1,
      "tag": "temp 0"
    },
    {
      "id": "ui",
      "type": "frontend",
      "label": "Streamlit / CLI",
      "sublabel": "localhost:8501",
      "stage": 4,
      "row": 2,
      "tag": "prueba"
    }
  ],
  "flows": [
    {
      "id": "oficial-captura",
      "from": "oficial",
      "to": "webclient",
      "label": "HTML oficial",
      "classification": "institucional",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "terceros-captura",
      "from": "terceros",
      "to": "webclient",
      "label": "prensa",
      "classification": "indicadores",
      "variant": "default"
    },
    {
      "id": "captura-limpieza",
      "from": "webclient",
      "to": "extractor",
      "label": "data/raw",
      "classification": "bronze",
      "variant": "emphasis"
    },
    {
      "id": "limpieza-gold",
      "from": "extractor",
      "to": "gold",
      "label": "Markdown",
      "classification": "silver → gold",
      "variant": "emphasis"
    },
    {
      "id": "gold-chunks",
      "from": "gold",
      "to": "chunker",
      "label": "documentos",
      "classification": "derivado",
      "variant": "default"
    },
    {
      "id": "chunks-embeddings",
      "from": "chunker",
      "to": "embeddings",
      "label": "fragmentos",
      "classification": "texto",
      "variant": "default"
    },
    {
      "id": "embeddings-faiss",
      "from": "embeddings",
      "to": "faiss",
      "label": "vectores",
      "classification": "persistido",
      "variant": "default"
    },
    {
      "id": "faiss-llm",
      "from": "faiss",
      "to": "llm",
      "label": "k=5 fragmentos",
      "classification": "recuperación",
      "variant": "emphasis"
    },
    {
      "id": "llm-ui",
      "from": "llm",
      "to": "ui",
      "label": "respuesta citada",
      "classification": "oficial vs tercero",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Contrato gold",
      "items": [
        "Solo data/gold/ se versiona: 21 documentos Markdown",
        "El front matter registra url, title, domain y source_type",
        "El RAG no toca la web: todo se deriva de gold"
      ]
    },
    {
      "dot": "cyan",
      "title": "Memoria del asistente",
      "items": [
        "El system prompt consolida el corpus completo (88.7 KB)",
        "Instruye responder solo con el corpus y citar la fuente",
        "Exige distinguir fuente oficial de fuente de terceros"
      ]
    },
    {
      "dot": "orange",
      "title": "Caché y costo",
      "items": [
        "La huella SHA-256 invalida el índice al cambiar el corpus",
        "Primera construcción: 753 s en CPU; después, segundos",
        "Los embeddings son locales: no cuestan tokens"
      ]
    },
    {
      "dot": "rose",
      "title": "Evaluación",
      "items": [
        "30 preguntas en data/questions.json → docs/resultados.md",
        "Criterios: exactitud, no alucinar y citar fuentes",
        "Cinco preguntas nuevas cubren indicadores financieros"
      ]
    }
  ]
}

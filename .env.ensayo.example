# Ensayo general contra producción (docs/ensayo.md).
# Copia este archivo a .env.ensayo (no se versiona) y rellena los valores reales.
# Lo carga el Makefile con `set -a; . ./.env.ensayo`: CLAVE=valor, sin espacios en el `=`.
# Nunca pongas aquí secretos: MCP_TOKEN y WEBHOOK_SECRET se leen del .env del servidor.

# --- App bajo prueba ------------------------------------------------------------------
ENSAYO_BASE_URL=http://203.0.113.10:8080
# local | prod (por defecto: local si el host es 127.0.0.1/localhost, si no prod)
ENSAYO_TARGET=prod
# Sufijo de alias y marcas; vacío = hora UTC AAAAMMDDhhmmss
# ENSAYO_RUN_ID=

# --- Servidor de la app (SSH con clave, sin contraseña) ---------------------------------
ENSAYO_APP_SSH=deploy@203.0.113.10
ENSAYO_APP_SSH_PORT=22
ENSAYO_APP_DIR=/opt/carvajal

# --- VM de OpenClaw (SSH + sudo -n -u <usuario> sin contraseña) ------------------------
ENSAYO_OPENCLAW_SSH=operador@198.51.100.20
ENSAYO_OPENCLAW_USER=marko

# --- WhatsApp por MCP y webhook ---------------------------------------------------------
# En producción el MCP va por un túnel SSH automático; estas dos solo se usan en local.
# Déjalas comentadas: una variable definida pero vacía anula el valor por defecto.
# ENSAYO_MCP_URL=http://127.0.0.1:8765/mcp
# ENSAYO_MCP_TOKEN=
# Vacío = se lee WEBHOOK_SECRET del .env del servidor (o del .env local)
# ENSAYO_WEBHOOK_SECRET=
# Remitente ficticio fuera de WEBHOOK_ALLOWED_NUMBERS
ENSAYO_WA_FUERA=+15550100999
# todas | una | ninguna: cuántos guiones registran folio (en producción, `una`)
ENSAYO_COTIZAR=una
ENSAYO_MEDIA_DIR=data/openclaw-media

# --- WhatsApp real con Firefox (test_whatsapp_real.py) ---------------------------------
# Número del bot (el vinculado en OpenClaw) en E.164
ENSAYO_WA_BOT=+57XXXXXXXXXX
# Puerto de Marionette de `firefox --marionette` (vacío = 2828)
# ENSAYO_FIREFOX_MARIONETTE=
# Segundos que se vigila el chat tras el envío
ENSAYO_WA_ESPERA=90

# --- Expectativas opcionales (test_operacion.py) ---------------------------------------
# ENSAYO_EXPECT_AGENT_MODE=tools
# ENSAYO_EXPECT_WEBHOOK=1
# ENSAYO_EXPECT_JEV=1
# ENSAYO_EXPECT_DIMENSIONS=768
# ENSAYO_REPO_LIMPIO=1
# ENSAYO_OPENCLAW_UNITS="openclaw-gateway ovh-tunnel ovh-media-tunnel"

# Copia este archivo como .env y completa los valores reales.
# .env está en .gitignore: nunca lo subas al repositorio.

# Puerto público de la demo (http://IP_DEL_VPS:8080). La app se publica en
# 0.0.0.0; cambia APP_PORT si ese puerto está ocupado.
APP_PORT=8080

# Proveedor del LLM: ollama | deepseek | claude
LLM_PROVIDER=deepseek

# DeepSeek (API compatible con OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama para embeddings (nomic-embed-text). En local el valor por defecto ya
# es http://127.0.0.1:11434; en compose.prod.yml se usa el servicio `ollama`.
# Si usas un Ollama externo, descomenta y apunta a su URL.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Ventana de contexto del LLM local. La FAQ envía el corpus completo.
# OLLAMA_NUM_CTX=32768

# Anthropic Claude (opcional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Base de datos local (docker compose, servicio db)
# Usuario, clave y base deben coincidir con las del contenedor.
POSTGRES_USER=carvajal
POSTGRES_PASSWORD=carvajal
POSTGRES_DB=carvajal
POSTGRES_PORT=5432
# Opcional: si se omite, Settings.database_url se deriva de las variables
# POSTGRES_* de arriba (mismo contenedor y mismo puerto). Si se define, debe
# usar el mismo POSTGRES_PORT o la derivación no aplica.
# DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/base

# RAG del M2: Qdrant es el índice evaluado. El corpus se indexa aparte con
# `make index` (o `uv run carvajal index-qdrant`). Postgres conserva chat y
# memoria del agente; Qdrant solo guarda fragmentos y procedencia.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=carvajal_chunks
QDRANT_DIMENSIONS=768
QDRANT_DISTANCE=Cosine
RAG_TOP_K=6
RAG_MIN_SCORE=0.30

# Memoria del agente: postgres (PostgresSaver + PostgresStore) o sqlite para
# una demo local con archivo persistente.
AGENT_CHECKPOINTER=postgres

# Frontend propio (:8001) y orígenes permitidos por CORS en la API (:8000).
FRONTEND_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Firma de la cookie anónima del visitante (historial y cupos).
# En desarrollo puede quedar vacío: Settings usa un secreto aleatorio por
# proceso. En producción es obligatorio y compose.prod.yml falla si falta:
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=
# Captura web desde Configuración. Es pública en esta fase: el límite y el
# guard SSRF son la defensa. El máximo por ejecución se deriva de las semillas
# (24 por defecto); CAPTURE_DEFAULT_URLS es solo el valor inicial del control.
CAPTURE_DEFAULT_URLS=5
CAPTURE_MAX_BYTES=5000000
CAPTURE_TIMEOUT_SECONDS=30
CAPTURE_MAX_REDIRECTS=5
# Límite por IP del endpoint público: N capturas por ventana. Cero lo desactiva.
CAPTURE_REQUESTS_LIMIT=5
CAPTURE_WINDOW_SECONDS=3600
# Allowlist opcional separada por coma (ej. carvajal.com,larepublica.co).
# Vacía = cualquier host público que pase el guard SSRF.
CAPTURE_ALLOWED_DOMAINS=
# Solo para desarrollo: permite loopback, redes privadas y puertos no estándar.
CAPTURE_ALLOW_PRIVATE_HOSTS=false

# Cuota diaria por visitante anónimo (W4.2). La medianoche se calcula en
# QUOTA_TIMEZONE, no en el TZ del contenedor.
DAILY_REQUESTS_LIMIT=20
QUOTA_TIMEZONE=America/Bogota

# Voz a texto del chat (Speaches con faster-whisper). `make whisper` levanta el
# servicio en http://127.0.0.1:9000 (valor por defecto de Settings). En
# compose.prod.yml se sobrescribe a http://whisper:8000.
# TRANSCRIPTION_URL=http://127.0.0.1:9000
TRANSCRIPTION_MODEL=Systran/faster-whisper-small
TRANSCRIPTION_LANGUAGE=es
# Límite de dictados por IP, independiente de la cuota diaria de preguntas.
TRANSCRIPTION_REQUESTS_LIMIT=20
TRANSCRIPTION_WINDOW_SECONDS=3600
TRANSCRIPTION_MAX_BYTES=2000000
TRANSCRIPTION_TIMEOUT_SECONDS=120

# Observabilidad (W6.3). Logs JSON en stdout; sin SENTRY_DSN no se envía nada.
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Proxy TLS: uvicorn solo confía en X-Forwarded-* desde estas IPs. En esta
# demo no hay proxy delante, así que se mantiene 127.0.0.1 y los clientes no
# pueden falsificar las cabeceras. Si añades nginx/Caddy, pon su IP o subred.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Copia este archivo como .env y completa los valores reales.
# .env está en .gitignore: nunca lo subas al repositorio.

# Puerto público de la demo (http://IP_DEL_VPS:8080). La app se publica en
# 0.0.0.0; cambia APP_PORT si ese puerto está ocupado.
APP_PORT=8080

# Proveedor del LLM del chat: deepseek (por defecto, en la nube) | ollama | claude.
# Sin DEEPSEEK_API_KEY el chat degrada a routes: saludos, indicadores y cotizaciones
# siguen, pero las respuestas redactadas por el LLM fallan; la app lo avisa al arrancar
# (llm.provider_unconfigured) y /health lo muestra en agent.tools_unavailable_reason.
LLM_PROVIDER=deepseek
# Tiempo máximo de espera por llamada al LLM, en segundos.
LLM_TIMEOUT_SECONDS=60

# DeepSeek (API compatible con OpenAI). El agente con herramientas (AGENT_MODE=tools,
# por defecto) usa DeepSeek y solo arranca con LLM_PROVIDER=deepseek. deepseek-flash es el
# modelo con el que se evaluó y decidió el modo tools (spec 044, evidencia §10).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama queda SOLO para embeddings (nomic-embed-text): el chat no lo usa salvo que
# fijes LLM_PROVIDER=ollama a mano (desarrollo sin red). En local el valor por
# defecto ya es http://127.0.0.1:11434; en compose.prod.yml se usa el servicio
# `ollama`. Si usas un Ollama externo, descomenta y apunta a su URL.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo de chat solo cuando LLM_PROVIDER=ollama. `make up` lo descarga únicamente
# en ese caso; en producción el runbook descarga solo el de embeddings.
OLLAMA_MODEL=llama3.2
# Ventana de contexto del LLM local. La FAQ envía el corpus completo.
# OLLAMA_NUM_CTX=32768

# Anthropic Claude (opcional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Base de datos local (docker compose, servicio db)
# Usuario, clave y base deben coincidir con las del contenedor.
POSTGRES_USER=carvajal
POSTGRES_PASSWORD=carvajal
POSTGRES_DB=carvajal
POSTGRES_PORT=5432
# Opcional: si se omite, Settings.database_url se deriva de las variables
# POSTGRES_* de arriba (mismo contenedor y mismo puerto). Si se define, debe
# usar el mismo POSTGRES_PORT o la derivación no aplica.
# DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/base

# RAG del M2: Qdrant es el índice evaluado. El corpus se indexa aparte con
# `make index` (o `uv run carvajal index-qdrant`). Postgres conserva chat y
# memoria del agente; Qdrant solo guarda fragmentos y procedencia.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=carvajal_chunks
QDRANT_DIMENSIONS=768
QDRANT_DISTANCE=Cosine
RAG_TOP_K=6
RAG_MIN_SCORE=0.30

# Memoria del agente: postgres (PostgresSaver + PostgresStore) o sqlite para
# una demo local con archivo persistente.
AGENT_CHECKPOINTER=postgres
# Enrutador del agente (spec 036): rules (por defecto), llm o decision. Con decision,
# DECISION_MODEL apunta a la fábrica del modelo, como paquete.modulo:fabrica.
AGENT_ROUTER=rules
DECISION_MODEL=
# Spec 044: tools (agente con herramientas, por defecto) o routes (enrutador por
# reglas, interruptor de emergencia). El modo tools usa DeepSeek y solo arranca con
# LLM_PROVIDER=deepseek y DEEPSEEK_API_KEY; si no, los turnos siguen por routes con
# LLM_PROVIDER (un aviso agent.tools_mode_unavailable lo registra). Límites por turno del
# modo tools: llamadas a herramientas, segundos y cotizaciones mostradas.
AGENT_MODE=tools
AGENT_MAX_TOOL_CALLS=4
AGENT_TURN_TIMEOUT_S=45
AGENT_MAX_QUOTES=3
# Spec 045: resumen acumulado de los turnos que salen de la ventana (llm, deterministic u
# off; deterministic hasta medir el prompt del resumidor), su plazo en segundos y su tope de
# caracteres; días que dura la memoria del dueño sin actualizarse; plazo en segundos de la
# herramienta preguntas_frecuentes (menor que AGENT_TURN_TIMEOUT_S).
AGENT_SUMMARY_MODE=deterministic
AGENT_SUMMARY_TIMEOUT_S=8
AGENT_SUMMARY_MAX_CHARS=1500
AGENT_MEMORY_DAYS=180
AGENT_FAQ_TIMEOUT_S=25
# Spec 046: Jev de TypeSafe (System One) como gatekeeper del modo tools (pregunta Choice) y
# compuerta de afirmaciones (pregunta Noul). Apagado por defecto aunque haya clave: se
# enciende con JEV_ENABLED=true (producción, en el .env del servidor). Sin Jev, reglas + LLM
# y la compuerta determinista, como antes. La clave nunca se escribe en logs ni trazas.
# JEV_LEDGER anota cada llamada (sin texto) en un JSONL para llevar la cuenta del gasto.
# JEV_ROUTER_MODE: on | shadow (consulta y registra sin restringir) | off.
# JEV_CLAIMS_MODE: enforce (sustituye lo no respaldado) | shadow (solo registra) | off.
# JEV_MODEL: modelo fijado y medido (spec 046, evidencia.md); no usar jev-latest, que puede
# cambiar sin repetir la medición.
# Umbrales del gatekeeper: confianza mínima general y de la respuesta directa (≥ general).
# JEV_CLAIMS_THRESHOLD: por debajo, la respuesta se marca como no respaldada. Los tres
# valores (0.6, 0.8 y 0.5) se confirmaron en la medición del 2026-11-24.
# JEV_MAX_CALLS_PER_DAY es por proceso y se reinicia a medianoche de Bogotá.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_LEDGER=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=0.8
JEV_ROUTER_MODE=on
JEV_ROUTER_MIN_CONFIDENCE=0.6
JEV_ROUTER_DIRECT_MIN_CONFIDENCE=0.8
JEV_CLAIMS_MODE=enforce
JEV_CLAIMS_THRESHOLD=0.5
JEV_MAX_CALLS_PER_DAY=1000
JEV_MAX_EVIDENCE_CHARS=12000

# Voz del chat web por el servidor con OpenAI (spec 047). VOICE_PROVIDER=browser (por
# defecto) deja el dictado y la lectura del navegador y el audio no llega al servidor.
# Con VOICE_PROVIDER=openai y OPENAI_API_KEY, el dictado sube el audio a
# /api/voz/transcribir (no se guarda) y la lectura pide /api/voz/hablar por el id de la
# respuesta; ante cualquier fallo, 503 o tope, el navegador vuelve a su voz. La clave solo
# vive aquí (nunca en el repo, en /health ni en logs). El dictado exige HTTPS.
# VOICE_MAX_CALLS_PER_DAY es por proceso (STT + TTS) y se reinicia a medianoche de Bogotá;
# VOICE_RATE_LIMIT llamadas cada VOICE_RATE_WINDOW_S segundos por sesión del chat.
VOICE_PROVIDER=browser
OPENAI_API_KEY=
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral
# Vacío usa el estilo por defecto: asesora comercial colombiana, cálida y pausada.
# VOICE_TTS_INSTRUCTIONS=
VOICE_TTS_MAX_CHARS=1200
VOICE_MAX_AUDIO_SECONDS=60
VOICE_MAX_UPLOAD_BYTES=2000000
VOICE_MAX_CALLS_PER_DAY=500
VOICE_RATE_LIMIT=20
VOICE_RATE_WINDOW_S=600
VOICE_TIMEOUT_S=20

# Interfaz única (:8000): el shell Jinja2/HTMX sirve las pantallas y la API.
# Firma de la cookie anónima del visitante (historial y cupos).
# En desarrollo puede quedar vacío: Settings usa un secreto aleatorio por
# proceso. En producción es obligatorio y compose.prod.yml falla si falta:
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=
# Token compartido de operador para la carga y la captura web. No es un
# sistema de cuentas: es un solo secreto de despliegue. Si queda vacío, la
# escritura web se deshabilita y el operador usa la CLI interna.
# `CONFIG_TOKEN` se acepta como alias del mecanismo anterior.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=
# Captura web desde Configuración. Exige el token de operador y solo deja las
# páginas en Gold para revisión; la publicación se hace con `carvajal sync`.
# El máximo por ejecución se deriva de las semillas (24 por defecto);
# CAPTURE_DEFAULT_URLS es solo el valor inicial del control.
CAPTURE_DEFAULT_URLS=5
CAPTURE_MAX_BYTES=5000000
CAPTURE_TIMEOUT_SECONDS=30
CAPTURE_MAX_REDIRECTS=5
# Límite por IP del endpoint público: N capturas por ventana. Cero lo desactiva.
CAPTURE_REQUESTS_LIMIT=5
CAPTURE_WINDOW_SECONDS=3600
# Allowlist opcional separada por coma (ej. carvajal.com,larepublica.co).
# Vacía = cualquier host público que pase el guard SSRF.
CAPTURE_ALLOWED_DOMAINS=
# Solo para desarrollo: permite loopback, redes privadas y puertos no estándar.
CAPTURE_ALLOW_PRIVATE_HOSTS=false

# WhatsApp por OpenClaw (servidor MCP, docs/whatsapp-openclaw.md). Apagado por
# defecto: para activarlo en el servidor descomenta COMPOSE_PROFILES y define
# MCP_TOKEN. El puerto se publica solo en 127.0.0.1 y se alcanza por túnel SSH.
# Genera el token con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# COMPOSE_PROFILES=whatsapp
MCP_TOKEN=
MCP_PORT=8765
# URL pública de la web para el enlace al PDF de la cotización que se ofrece por
# WhatsApp (p. ej. http://203.0.113.10:8080). Vacía: no se ofrece el PDF.
PUBLIC_BASE_URL=

# Webhook firmado de mensajería: POST /api/webhooks/whatsapp (docs/webhooks.md).
# Vacío = deshabilitado (404). Cada petición firma «<timestamp>.<cuerpo>» con
# HMAC-SHA256 en X-Carvajal-Signature y manda X-Carvajal-Timestamp (±5 minutos).
# Genera el secreto con: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Números autorizados en E.164, separados por comas (ej. +573100000000,+573110000000)
# o como lista JSON (ej. ["+573100000000","+573110000000"]).
# Vacía rechaza todos los remitentes (403); "*" acepta cualquier E.164 (modo abierto: la
# firma sigue siendo obligatoria y el cupo es por número). Usa también SESSION_SECRET.
WEBHOOK_ALLOWED_NUMBERS=

# Cuota diaria por visitante anónimo (W4.2). La medianoche se calcula en
# QUOTA_TIMEZONE, no en el TZ del contenedor.
DAILY_REQUESTS_LIMIT=20
QUOTA_TIMEZONE=America/Bogota

# Observabilidad (W6.3). Logs JSON en stdout; sin SENTRY_DSN no se envía nada.
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Monitoreo del agente con LangSmith (spec 038). Apagado por defecto: sin
# MONITORING_ENABLED no se construye cliente ni sale un solo byte del proceso.
# En producción solo metadatos (MONITORING_INCLUDE_CONTENT=false); el contenido
# completo se reserva para desarrollo y para las corridas de evaluación.
MONITORING_ENABLED=false
# Obligatoria si el monitoreo se enciende; nunca se registra en logs ni en /health.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=carvajal
# Identidad del agente en cada traza: separa local, CI y producción dentro del
# mismo proyecto. Vacío no añade la clave y la traza queda como antes.
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
# Vacío usa el servicio público; permite fijar otro endpoint compatible.
LANGSMITH_ENDPOINT=
# Fracción de turnos trazados (0..1). Con 0.2 y el plan de 5.000 trazas/mes se
# cubren hasta 25.000 turnos; 1.0 solo en local y evaluación.
MONITORING_SAMPLE_RATE=0.2
MONITORING_INCLUDE_CONTENT=false
MONITORING_TIMEOUT_MS=2000
# No se usan LANGSMITH_TRACING ni LANGCHAIN_TRACING_V2: el encendido es
# explícito por turno y la app fuerza ambas a false al arrancar, para que una
# variable heredada del entorno no empiece a enviar contenido.

# Proxy TLS: uvicorn solo confía en X-Forwarded-* desde estas IPs. En esta
# demo no hay proxy delante, así que se mantiene 127.0.0.1 y los clientes no
# pueden falsificar las cabeceras. Con nginx en el host delante del contenedor,
# pon la IP de la puerta de enlace de la red de Docker (p. ej. 172.18.0.1), que es
# desde donde el contenedor ve llegar al proxy (docs/despliegue-ovh.md §10).
# FORWARDED_ALLOW_IPS=127.0.0.1

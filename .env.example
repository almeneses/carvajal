# Copia este archivo como .env y completa los valores reales.
# .env está en .gitignore: nunca lo subas al repositorio.

# Proveedor del LLM: ollama | deepseek | claude
LLM_PROVIDER=deepseek

# DeepSeek (API compatible con OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic Claude (opcional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Base de datos local (docker compose, servicio db)
# Usuario, clave y base deben coincidir con las del contenedor.
POSTGRES_USER=carvajal
POSTGRES_PASSWORD=carvajal
POSTGRES_DB=carvajal
POSTGRES_PORT=5432
# Opcional: si se omite, Settings.database_url se deriva de las variables
# POSTGRES_* de arriba (mismo contenedor y mismo puerto). Si se define, debe
# usar el mismo POSTGRES_PORT o la derivación no aplica.
# DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/base

# Firma de la cookie anónima del visitante (historial y cupos).
# En producción usa un valor largo y aleatorio: `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`.
SESSION_SECRET=desarrollo-local

# Cupo diario de preguntas por visitante (W4.2; por defecto 20).
DAILY_REQUESTS_LIMIT=20

# Observabilidad (W6.3). Logs JSON en stdout; sin SENTRY_DSN no se envía nada.
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Acceso con Google (W4.1). Sin client_id el login responde 503 y la app sigue
# funcionando en modo anónimo. El redirect debe coincidir con el registrado en
# Google Cloud (localhost en desarrollo, el dominio del VPS en producción).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_SESSION_DAYS=14

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv/

# Testing / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment
.env
.env.*
!.env.example

# Datos del corpus: capas crudas (bronze) y procesadas (silver) se ignoran;
# el entregable versionado es data/gold/ (capa gold).
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Fuentes primarias del catálogo de Colombia: el PDF no se versiona por tamaño;
# su ruta, fecha y hash quedan en data/catalog/empaques/manifest.json.
data/catalog/empaques/fuentes/*.pdf

# Corpus externo: derivados regenerables con `carvajal import`; solo se versiona
# el manifiesto de cada fuente para dejar constancia de qué se importó.
data/external/*/*
!data/external/*/manifest.json

# Descarga del corpus externo en la raíz del repo: regenerable, pesa ~3,8 GB
# y nunca se versiona (el manifiesto sí, en data/external/).
external_corpus/
external_corpus.zip

# Bloqueo y temporal de la escritura atómica del índice del corpus.
data/gold/.index.jsonl.*

# Índice vectorial FAISS (se regenera desde data/gold/ con `make app` o `carvajal ask`)
data/index/

# Arteefactos
*.log

# IDE
.vscode/
.idea/

# Herramientas de agentes con entornos vendorizados (no se versiona)
.dsh/

# Artefactos generados de evaluación/evidencia (se regeneran con make index-eval / smoke_m2)
docs/eval/retrieval-results.json
docs/evidence/m2/tests-*.txt
data/catalog/empaques/imagenes/revision.html

# Contexto mínimo de la imagen: solo lo que el build y el runtime necesitan.
.git
.github
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.ty_cache
.mypy_cache
.coverage
htmlcov
dist
build
*.egg-info
# El corpus y los artefactos no entran en la imagen, pero el extracto de
# indicadores sí: la herramienta `indicator_lookup` lo lee en runtime desde
# `data/indicators.json`. La negación debe excluir el contenido, no el
# directorio padre, para que Docker pueda re-incluir el archivo.
data/*
!data/indicators.json
docs
specs
tests
assets
scripts
.streamlit
.opencode
.specify
.env
.env.*
*.log
